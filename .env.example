# Server Configuration
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/intellmeet?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_token_min_64_chars_at_least_random_long_string_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_min_64_chars_at_least_random_long_string_here
REFRESH_TOKEN_EXPIRY=7d

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash

# Cloudinary Credentials (avatars/images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Configuration (meeting recordings)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=intellmeet-recordings

# Email Configuration (Gmail / SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=IntellMeet <noreply@intellmeet.com>

# Sentry DSN (for error monitoring)
SENTRY_DSN=your_sentry_dsn

# WebRTC TURN Server configuration
TURN_SERVER_URL=turn:your_turn_server:3478
TURN_SERVER_USERNAME=intellmeet
TURN_SERVER_CREDENTIAL=your_turn_credential

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
